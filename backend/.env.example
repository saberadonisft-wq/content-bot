# Content Bot v1 local configuration
#
# Copy this file to backend/.env only if backend/.env does not already exist.
# Fill API keys locally; never commit or paste them into chat.

# Local v1 storage and API. Keep localhost unless you deliberately need LAN access.
CONTENT_BOT_DATA_DIR=data
MONGODB_URI=
MONGODB_DATABASE=content_bot
# Optional DNS override for mongodb+srv when the system has a stale resolver.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
CONTENT_BOT_HOST=127.0.0.1
CONTENT_BOT_PORT=8000
CONTENT_BOT_MAX_VIDEO_SIZE_BYTES=524288000
CONTENT_BOT_MAX_OVERLAY_SIZE_BYTES=10485760
CONTENT_BOT_MEDIA_PROBE_TIMEOUT_SECONDS=120
CONTENT_BOT_THUMBNAIL_TIMEOUT_SECONDS=90
CONTENT_BOT_SUBTITLE_JOB_CONCURRENCY=1
CONTENT_BOT_ALIGNMENT_ENGINE=energy
CONTENT_BOT_ALIGNMENT_WHISPER_MODEL=small
CONTENT_BOT_ALIGNMENT_WHISPER_DEVICE=auto
CONTENT_BOT_ALIGNMENT_WHISPER_COMPUTE_TYPE=auto
CONTENT_BOT_ALIGNMENT_WHISPER_ALLOW_DOWNLOAD=false
CONTENT_BOT_ALIGNMENT_CPU_THREADS=4
CONTENT_BOT_ALIGNMENT_EXTRACT_TIMEOUT_SECONDS=90
CONTENT_BOT_SUBTITLE_RENDER_TIMEOUT_SECONDS=7200
# Gemini subtitle generation uses the official globally installed Gemini CLI.
# The rolling input dataset and worker kernel must remain private.
# Consumer Google-account OAuth for Gemini CLI was retired; use a key from
# Google AI Studio or configure Vertex AI for this automated worker.
CONTENT_BOT_GEMINI_CLI_ENABLED=true
CONTENT_BOT_GEMINI_CLI_PATH=
CONTENT_BOT_GEMINI_CLI_MODEL=auto
GEMINI_API_KEY=
CONTENT_BOT_GEMINI_CLI_TIMEOUT_SECONDS=1800
CONTENT_BOT_GEMINI_CLI_CHUNK_SECONDS=180
CONTENT_BOT_GEMINI_CLI_MAX_INPUT_MB=19
CONTENT_BOT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Browser destination after an OAuth callback. It contains status only, never tokens.
CONTENT_BOT_FRONTEND_URL=http://127.0.0.1:5173/
CONTENT_BOT_CRAWLER_RETENTION_DAYS=90
CONTENT_BOT_CRAWLER_RETENTION_INTERVAL_HOURS=24

# Optional: official YouTube Data API v3 search.
# Leave blank to keep YouTube disabled. Game News, Steam and Bluesky still work.
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=VN
YOUTUBE_RELEVANCE_LANGUAGE=vi
# Per-run safeguards. search.list uses its own granular quota bucket; other
# read calls use the project's general YouTube Data API quota.
YOUTUBE_SEARCH_REQUEST_BUDGET=10
YOUTUBE_GENERAL_REQUEST_BUDGET=25
YOUTUBE_COMMENT_REQUEST_BUDGET=25

# Official Reddit OAuth app credentials. Create a script/web app at reddit.com/prefs/apps.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ContentBot/0.1 (local research tool)
REDDIT_COMMENT_REQUEST_BUDGET=20

# Public Steam Store/review limits. Pin a specific game by saving its /app/<id>
# URL as a channel; keyword discovery fails closed on ambiguous tied matches.
STEAM_MAX_DISCOVERED_APPS=3
STEAM_DISCOVERY_REQUEST_BUDGET=5
STEAM_REVIEW_REQUEST_BUDGET=20
STEAM_REVIEW_FILTER=recent
STEAM_REVIEW_LANGUAGE=all
STEAM_PURCHASE_TYPE=all

# Public Bluesky AppView request cap per source run.
BLUESKY_REQUEST_BUDGET=20

# Public Mastodon hashtag/account discovery. Only these exact HTTPS instance
# hosts can be saved as Mastodon channels; discovery is instance-scoped rather
# than a Fediverse-wide full-text search.
MASTODON_INSTANCES=mastodon.social,mastodon.gamedev.place,dice.camp
MASTODON_REQUEST_BUDGET=30

# Official X API v2 read-only bearer token. Enables manual recent search and
# saved creator timeline ingestion; public embeds remain available without it.
# X API reads are pay-per-use, so leave blank unless the app has eligible access
# and credits in the Developer Console.
X_BEARER_TOKEN=

# Official Meta Graph API access. Pin a reviewed API version (for example,
# vXX.X) instead of silently following the platform default. Leave blank until
# App Review/Advanced Access and the required Instagram Professional account
# permissions have been approved.
META_GRAPH_API_VERSION=
META_ACCESS_TOKEN=
INSTAGRAM_PROFESSIONAL_USER_ID=

# Official Facebook Pages API for one Page that the configured Page access
# token is authorized to read. This is not global Facebook search and does not
# cover profiles, Groups, or arbitrary public Pages without approved access.
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_USERNAME=

# Official TikTok Login Kit + Display API. This can read only the public videos
# of the account that explicitly authorized user.info.basic +
# user.info.profile + video.list; profile scope verifies the creator handle. It is
# not global TikTok search. Keep tokens server-side and leave blank until the
# app/product/scopes have been approved in TikTok for Developers. Register the
# exact static HTTPS callback below and expose the OAuth start route on that
# same HTTPS origin (normally through the app's reverse proxy/tunnel).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Example: https://content.example.com/api/v1/auth/tiktok/callback
TIKTOK_REDIRECT_URI=
# Legacy server-side credential compatibility only. New UI connections store
# access/refresh tokens encrypted under CONTENT_BOT_DATA_DIR/crawler-secrets.
TIKTOK_USER_ACCESS_TOKEN=
TIKTOK_USER_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_AUTHORIZED_USERNAME=
TIKTOK_GRANTED_SCOPES=

# Clean-room crawler engine (CBCE) Phase 2 runtime. It stays disabled until an
# internal platform adapter passes conformance and security review.
CONTENT_BOT_CBCE_ENABLED=false
CONTENT_BOT_CBCE_PROFILE_ROOT=data/browser-profiles-v2
CONTENT_BOT_CBCE_EVENT_QUEUE_SIZE=100
CONTENT_BOT_CBCE_CLEANUP_TIMEOUT_SECONDS=10
# Explicit Cốc Cốc/Chromium executable for CBCE-owned visible sessions.
CONTENT_BOT_CBCE_BROWSER_EXECUTABLE_PATH=
# JSON object keyed by canonical source ID, then operation, then provider ID.
CONTENT_BOT_CBCE_PROVIDER_OVERRIDES={}
CONTENT_BOT_CBCE_CONTRACT_ROOT=data/crawler-contracts-v1

# MediaCrawler v1 uses a visible, per-platform browser login. Do not put social
# passwords, cookies or tokens here. Leave this override empty for normal use.
MEDIACRAWLER_COMMAND=
MEDIACRAWLER_PROFILE_DIR=data/browser-profile
MEDIACRAWLER_TIMEOUT_SECONDS=600
CONTENT_BOT_COCCOC_EXECUTABLE_PATH=C:\Program Files\CocCoc\Browser\Application\browser.exe

# Optional HTTPS RSS/Atom templates. Use {query} for the URL-encoded keyword.
# A JSON array is recommended (and preserves commas inside URLs); legacy comma
# separation remains supported. Leave blank to use the bundled game-news feed.
WEB_FEED_URLS=
