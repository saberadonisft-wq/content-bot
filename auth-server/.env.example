# ==========================================
# Content Bot Cloud Auth Server Configuration
# ==========================================

# Port and Host (default for Azure / Local)
PORT=8080
HOST=0.0.0.0

# MongoDB Atlas Connection URI
# e.g., mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=content_bot_auth

# JWT RSA Keys (RS256)
# If left blank, server will automatically generate and persist an RSA keypair locally
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Initial Admin User - Automatically approved with admin role upon registration
ADMIN_EMAIL=saberadonisft@gmail.com

# Google OAuth 2.0 (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback URL registered in Google Cloud Console
GOOGLE_REDIRECT_URI=https://content-bot-auth.azurewebsites.net/auth/google/callback

# Frontend Redirect URL after Google OAuth callback
FRONTEND_URL=http://127.0.0.1:5173

# Allowed CORS Origins (comma-separated, or * for all)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://content-bot-auth.azurewebsites.net

# Cloudflare R2 Storage (Optional for Admin release uploads & public downloads)
R2_PUBLIC_URL=https://releases.yourdomain.com
R2_BUCKET_NAME=content-bot-releases
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
