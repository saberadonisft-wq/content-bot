{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Content Bot: Auth Server",
      "type": "shell",
      "command": "${workspaceFolder}\\scripts\\launcher.ps1",
      "args": ["-Action", "auth"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": {
        "owner": "content-bot-auth",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting Content Bot auth server",
          "endsPattern": "Uvicorn running on"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "content-bot",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Content Bot: Backend",
      "type": "shell",
      "command": "${workspaceFolder}\\scripts\\launcher.ps1",
      "args": ["-Action", "backend"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": {
        "owner": "content-bot-backend",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting Content Bot backend",
          "endsPattern": "Uvicorn running on"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "content-bot",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Content Bot: Frontend",
      "type": "shell",
      "command": "${workspaceFolder}\\scripts\\launcher.ps1",
      "args": ["-Action", "frontend"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": {
        "owner": "content-bot-frontend",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting Content Bot frontend",
          "endsPattern": "Local:.*http://127\\.0\\.0\\.1:5173"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "content-bot",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Content Bot: Start",
      "dependsOn": [
        "Content Bot: Auth Server",
        "Content Bot: Backend",
        "Content Bot: Frontend"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Content Bot: Desktop Dev",
      "type": "shell",
      "command": "${workspaceFolder}\\scripts\\launcher.ps1",
      "args": ["-Action", "desktop"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "content-bot-desktop",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Content Bot: Doctor",
      "type": "shell",
      "command": "${workspaceFolder}\\scripts\\launcher.ps1",
      "args": ["-Action", "doctor"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Content Bot: Setup MediaCrawler",
      "type": "shell",
      "command": "${workspaceFolder}\\scripts\\launcher.ps1",
      "args": ["-Action", "setup-mediacrawler"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Content Bot: Setup Subtitles",
      "type": "shell",
      "command": "${workspaceFolder}\\scripts\\launcher.ps1",
      "args": ["-Action", "setup-subtitles"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
